use ::java::util::text::Text
use ::mcdoc::reg::status_ids::StatusID

dispatch minecraft:storage["registry:status"] to struct {
    new?: [NewStatusData],
    data?: [StatusData],
    this?: StatusData,
    instance?: StatusInstance,
    create?: struct{
        id: StatusID
    },
    temp?: [StatusInstance],
    run?: any
}

struct StatusInstance{
    content?: Text,
    instance?: int,
    id?: StatusID,
    until?: int
}


struct StatusData{
    ...NewStatusData,
    body?: Text
}

struct NewStatusData{
    /// Id of the status
    id?: StatusID,
    /// Must be zero width
    extra?: Text
}